# Copy this file to ".env" (same folder) and fill in your own values.
# This example file IS committed to git; the real .env is NOT.

# MySQL login (used by the app)
DB_USER=root
DB_PASSWORD=change-me

# JWT RSA key files (RS256). Keep them OUTSIDE the project folder so git never sees them.
# Use forward slashes / (a backslash \ is a special character in this file format).
JWT_PRIVATE_KEY_PATH=C:/Users/YOUR_NAME/.kaamsathi/keys/private.pem
JWT_PUBLIC_KEY_PATH=C:/Users/YOUR_NAME/.kaamsathi/keys/public.pem

# DEV ONLY: true = signup also returns the email-verify token in the X-Dev-Verify-Token
# header, so Postman can verify users automatically. Keep false anywhere except your own PC.
DEV_EXPOSE_TOKENS=false

# The one ADMIN account, created at app startup if missing
ADMIN_EMAIL=
ADMIN_PASSWORD=

