# Copy this file to ".env" (same folder) and fill in your own values.
# This example file IS committed to git; the real .env is NOT.

# MySQL login (used by every service)
DB_USER=root
DB_PASSWORD=change-me

# JWT RSA key files (RS256). Keep them OUTSIDE the project folder so git never sees them.
# Use forward slashes / (a backslash \ is a special character in this file format).
JWT_PRIVATE_KEY_PATH=C:/Users/YOUR_NAME/.hirebuddy/keys/private.pem
JWT_PUBLIC_KEY_PATH=C:/Users/YOUR_NAME/.hirebuddy/keys/public.pem

# The one ADMIN account, created at auth-service startup if missing (user/AdminSeeder)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secret shared by our services for service-to-service calls (not used yet)
INTERNAL_API_KEY=
