<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- My parent: I inherit its settings (Java 21, BOM versions, plugin setup) -->
    <parent>
        <groupId>com.jobportal</groupId>
        <artifactId>hirebuddy-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>auth-service</artifactId>
    <name>HireBuddy Auth Service</name>

    <dependencies>
        <!-- Spring Web MVC + embedded Tomcat: lets this service answer HTTP requests.
             No <version>: it comes from the Spring Boot BOM in the parent. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Our own shared code: Role, ApiError, ApiException, GlobalExceptionHandler.
             Same version as this project (both are 0.0.1-SNAPSHOT). -->
        <dependency>
            <groupId>com.jobportal</groupId>
            <artifactId>shared-lib</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Validation: rules on request fields (@NotBlank, @Email, @Size...) checked automatically. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Security as an OAuth2 "resource server": checks the JWT on protected endpoints,
             and brings NimbusJwtEncoder (makes + signs our tokens) and BCrypt. No JWT code written by hand. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- JPA (Hibernate): lets Java classes be saved as rows in database tables. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- MySQL driver: the "translator" between Java and MySQL.
             runtime: our code never uses it directly, only when the app runs. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway: runs our SQL files (db/migration/V1__..., V2__...) in order at startup,
             so every table change is written down and repeatable.
             Boot 4: the starter is needed (flyway-core alone is NOT auto-configured any more). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <!-- Flyway's MySQL support (Flyway keeps each database type in its own module). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Test tools for a Web MVC service: JUnit 6, AssertJ, Mockito,
             Spring test support + MockMvc (fake HTTP calls, no real server).
             scope test: used only by `mvn test`, NOT packed into the jar.
             Boot 4 split testing per technology, so the "webmvc" test starter
             is the one that brings MockMvc; it already includes spring-boot-starter-test. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Switch ON the Boot plugin. Its settings (version, repackage)
                 are already in the parent's pluginManagement. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
